{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "EtlCopilot",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "EtlCopilot"
  },
  "runtimes": [
    {
      "name": "EtlCopilot",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/EtlCopilot/",
      "runtimeVersion": "PYTHON_3_12",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "additionalPolicies": [
        "iam/runtime-policy.json"
      ],
      "lifecycleConfiguration": {
        "idleRuntimeSessionTimeout": 7200,
        "maxLifetime": 28800
      }
    }
  ],
  "memories": [
    {
      "name": "EtlCopilotMemory",
      "eventExpiryDuration": 365,
      "strategies": []
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "payments": []
}
