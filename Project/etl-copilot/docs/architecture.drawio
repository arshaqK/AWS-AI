        <!-- ================= Pipeline legend ================= -->
        <mxCell id="legend" value="&lt;div style=&quot;text-align:left;font-size:12px;line-height:1.7&quot;&gt;&lt;b style=&quot;font-size:13px&quot;&gt;How a new CSV becomes a clean table&lt;/b&gt;&lt;br&gt;&lt;b&gt;①&lt;/b&gt; Engineer uploads the CSV to landing/ from the console&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;②&lt;/b&gt; Glue Crawler catalogs it; Athena profiles every row&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;③&lt;/b&gt; Spec Writer proposes the contract → &lt;span style=&quot;color:#9A6A12&quot;&gt;&lt;b&gt;engineer approves&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;b&gt;④&lt;/b&gt; Script Writer drafts the ETL → &lt;span style=&quot;color:#9A6A12&quot;&gt;&lt;b&gt;engineer approves&lt;/b&gt;&lt;/span&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;⑤&lt;/b&gt; Glue job writes clean Parquet to staging/&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;⑥&lt;/b&gt; Athena validates against the contract (a failure → revised draft → ④)&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;⑦&lt;/b&gt; Documenter writes the data dictionary, quality report and CSV&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEE5;fontColor=#15212B;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1640" height="90" as="geometry" />
        </mxCell>
        <mxCell id="key" value="&lt;span style=&quot;font-size:11px;color:#5A6B78&quot;&gt;&lt;b style=&quot;color:#9A6A12&quot;&gt;Amber&lt;/b&gt; = human decision point&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b style=&quot;color:#DD344C&quot;&gt;Red&lt;/b&gt; = the only identity that touches data&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;dashed = streams / logs&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="900" height="24" as="geometry" />
        </mxCell>
